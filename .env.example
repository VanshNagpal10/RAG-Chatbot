# ─── Google Gemini (FREE — for the RAG chat LLM) ───
# Get your free key at: https://aistudio.google.com/apikey
# Used by /chat endpoint (Gemini 1.5 Flash). NOT used for embeddings.
GOOGLE_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=gsk_your_key_here

# ─── Embeddings ───
# No API key needed! BAAI/bge-small-en-v1.5 runs 100% locally.
# Model downloads automatically on first run (~130MB, cached forever).

# ─── OpenAI (OPTIONAL — only for Whisper transcription fallback) ───
# Most YouTube videos have captions, so Whisper rarely fires.
# OPENAI_API_KEY=sk-your-key-here

# ─── Cookie Authentication (pick ONE method) ───
# COOKIES_FROM_BROWSER=chrome
# COOKIES_PATH=./cookies.txt

# Logging level
LOG_LEVEL=INFO

# RAG chat LLM. Used by /chat. NOT used for embeddings.
GROQ_API_KEY=gsk_your_key_here

# Embeddings
# No API key needed! BAAI/bge-small-en-v1.5 runs 100% locally.
# Model downloads automatically on first run (~130MB, cached forever).

# Transcription
# No API key needed! faster-whisper runs 100% locally.

# Cookie authentication
# Local development can read browser cookies directly:
# COOKIES_FROM_BROWSER=chrome
#
# Local file option:
# COOKIES_PATH=./cookies.txt
#
# Hugging Face Space option:
# Add COOKIES_TXT as a Space secret containing the full Netscape-format
# cookies.txt content. scripts/start-space.sh writes it to /tmp/cookies.txt.
# COOKIES_TXT=

# Storage and logging
CHROMA_PERSIST_DIR=./chroma_db
LOG_LEVEL=INFO

# Whisper API key (OpenAI)
OPENAI_API_KEY=sk-your-key-here

# ─── Cookie Authentication (pick ONE method) ───
#
# METHOD 1 (EASIEST): Auto-extract cookies from your browser.
# Just set the browser name. yt-dlp handles the rest.
# Supports: chrome, firefox, safari, edge, opera, brave
COOKIES_FROM_BROWSER=chrome

# METHOD 2: Manual cookies.txt file.
# Export via "Get cookies.txt LOCALLY" Chrome extension.
# Only used if COOKIES_FROM_BROWSER is empty/unset.
# COOKIES_PATH=./cookies.txt

# Logging level
LOG_LEVEL=INFO
